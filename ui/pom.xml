<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>no.hal</groupId>
        <artifactId>riskfx-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>riskfx-ui</artifactId>
    <name>RiskFx user interface</name>
    <description>The user interface for playing and watching, in JavaFX, with the maps and the trained networks. It only runs the networks, so it needs no PyTorch, and it needs no Quarkus: it is started by the app (Quarkus), the web (JPro) and the mobile (Gluon) modules.</description>

    <dependencies>
        <dependency>
            <groupId>no.hal</groupId>
            <artifactId>riskfx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          The window as a jar, with the dependencies as its class path in the directory libs:
            mvn -Pplay package
            java -jar ui/target/riskfx-play.jar
          The trained networks are in the jar, and other ones can be used with the options ai2=file and ai4=file,
          each written with two hyphens in front.
        -->
        <profile>
            <id>play</id>
            <build>
                <finalName>riskfx-play</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <archive>
                                <manifest>
                                    <addClasspath>true</addClasspath>
                                    <classpathPrefix>libs/</classpathPrefix>
                                    <mainClass>no.hal.risk.fx.PlayLauncher</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <!-- JavaFX loads native libraries -->
                                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
