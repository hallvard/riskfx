<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>no.hal</groupId>
    <artifactId>riskfx-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
      core:     the rules of the game, the environment and the bots, and what it takes to run a trained network (in Java only)
      training: playing the games for training, and measuring the network. The network is trained by the learner, in Python (/learner)
      ui:       the user interface (JavaFX), which only needs the core, and the maps and the trained networks
      app:      starts the user interface on the desktop, with Quarkus (mvn quarkus:dev)
      web, mobile: the same user interface in a browser, and as a native Android app, in profiles of their own
    -->
    <modules>
        <module>core</module>
        <module>training</module>
        <module>ui</module>
        <module>app</module>
    </modules>

    <properties>
      <maven.compiler.release>23</maven.compiler.release>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <quarkus.version>3.28.0</quarkus.version>
      <javafx.version>24.0.2</javafx.version>
      <!-- <javafx.version>26-ea+7</javafx.version> -->
    </properties>

    <!--
      web: the same user interface in a browser, with JPro (https://www.jpro.one), which runs it on a server and shows it in the browser.
      It is a profile, since JPro comes from a repository of its own, which the other modules and the build on GitHub don't need:
        mvn -Pweb -pl web -am install
        mvn -Pweb -pl web jpro:run
    -->
    <!--
      mobile: the same user interface as a native app with Gluon (GraalVM native image), for Android. Gluon supports a narrower range of
      versions, so it is built with Java 23 and JavaFX 24, also the modules it uses, which this profile sets for the whole build:
        mvn -Pmobile -pl mobile -am install
        mvn -Pmobile -pl mobile gluonfx:run                       (the desktop, on a JVM, to try it)
        mvn -Pmobile -Pandroid -pl mobile gluonfx:build gluonfx:package   (only on Linux)
    -->
    <profiles>
        <profile>
            <id>mobile</id>
            <modules>
                <module>mobile</module>
            </modules>
            <properties>
                <maven.compiler.release>23</maven.compiler.release>
                <javafx.version>24.0.2</javafx.version>
            </properties>
        </profile>
        <profile>
            <id>web</id>
            <modules>
                <module>web</module>
            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>no.hal</groupId>
                <artifactId>riskfx-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>no.hal</groupId>
                <artifactId>riskfx-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <!-- JavaFX (in app) loads native libraries -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
